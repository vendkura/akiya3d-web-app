# =============================================================================
# Floorplan 3D Backend Environment Configuration
# Copy this file to .env and configure according to your environment
# =============================================================================

# API Configuration
APP_NAME=Floorplan 3D API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list)
# For local development: http://localhost:3000,http://localhost:5173
# For production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage Paths
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_UPLOAD_SIZE=50MB

# Model Configuration
# Path to the trained model weights directory
# For Windows: E:\path\to\akiya-3d-thesis\models
# For Linux/WSL: /mnt/e/path/to/akiya-3d-thesis/models
PROJECT_ROOT=/path/to/akiya-3d-thesis
MODEL_WEIGHTS_PATH=/path/to/akiya-3d-thesis/models/fpn_resnet50_v5.pth

# Processing Configuration  
PROCESSING_TIMEOUT=300
MAX_CONCURRENT_JOBS=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# Security (if needed in future)
# SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_HOURS=24