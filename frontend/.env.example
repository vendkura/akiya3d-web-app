# =============================================================================
# Floorplan 3D Frontend Environment Configuration
# Copy this file to .env and configure according to your environment
# =============================================================================

# API Configuration
# For local development: http://localhost:8000
# For production: https://your-backend-name.onrender.com (your Render backend URL)
VITE_API_URL=http://localhost:8000

# Application Configuration
VITE_APP_NAME=Floorplan 3D Converter
VITE_APP_VERSION=1.0.0

# Upload Limits (should match backend configuration)
VITE_MAX_UPLOAD_SIZE=52428800
VITE_SUPPORTED_FORMATS=.jpg,.jpeg,.png,.webp

# Development Configuration (only used in dev mode)
VITE_DEV_MODE=false
VITE_DEBUG_MODE=false

# Analytics (if needed in future)
# VITE_GA_TRACKING_ID=GA-XXXXXXXXX
# VITE_ANALYTICS_ENABLED=false

# Feature Flags (if needed)
# VITE_ENABLE_ROOM_LABELS=true
# VITE_ENABLE_PROGRESS_STEPS=true
# VITE_ENABLE_3D_VIEWER=true